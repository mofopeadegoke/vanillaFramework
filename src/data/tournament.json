  "faq": [
    {
      "q": "Do I need a rating to enter?",
      "a": "No. Unrated players are welcome and can enter the U1600 section (or Juniors, if eligible). If you have a national or FIDE rating, include it so we can seed you correctly."
    },
    {
      "q": "Is the tournament rated?",
      "a": "Yes. All games are submitted for national rapid rating. The event is not FIDE-rated."
    },
    {
      "q": "What should I bring?",
      "a": "Just yourself. Boards, sets and clocks are provided. Bring a pen if you would like to keep score; scoresheets are optional at this time control."
    },
    {
      "q": "Can I take a bye or arrive late?",
      "a": "You can request a half-point bye for round 1 on the registration form. Players who arrive after check-in closes receive a zero-point bye for round 1 and are paired from round 2."
    },
    {
      "q": "What is the refund policy?",
      "a": "Full refunds are available until the registration deadline (10 November). After that we can transfer your entry to another player."
    },
    {
      "q": "Is there food and parking?",
      "a": "The hall café serves hot food and drinks all day. There is free parking behind the hall and a bus stop on Mill Lane."
    },
    {
      "q": "What are the rules on phones and fair play?",
      "a": "Phones must be switched off and kept in a bag while you are playing. Smartwatches are not allowed in the playing hall. Arbiters may ask to inspect devices."
    },
    {
      "q": "Can friends and family watch?",
      "a": "Spectators are welcome in the viewing area. Please keep quiet near the boards and do not talk to players during their games."
    }
  ]
}
